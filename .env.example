# ȺցɾìҠìղ Environment Variables

# Database Connection (PostgreSQL or SQLite file)
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="agrikin-super-secure-jwt-secret-key-2026-prod-ready"

# AI Service Configuration
# Set your production Google Gemini or OpenAI API key here:
AI_API_KEY="mock-dev-key"
# When MOCK_AI=true or AI_API_KEY is unset, the high-fidelity agronomic AI engine will respond
MOCK_AI=true

# Weather Service Configuration
# Free Open-Meteo live satellite/reanalysis data is used by default with zero API key needed
WEATHER_API_KEY="open-meteo-free"
MOCK_WEATHER=false

# Storage Service Configuration
STORAGE_URL="http://localhost:3000/uploads"
STORAGE_KEY="dev-storage-secret"
MOCK_STORAGE=true

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
